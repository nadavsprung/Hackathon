<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp"
    tools:context=".SecondFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="עלת חומרים"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_long_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="כתוב כאן את התוכן שלך..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="5"
            android:gravity="top|start"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btn_upload_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="בחר תמונה מהגלריה"
            android:drawableStart="@android:drawable/ic_menu_gallery" />

        <ImageView
            android:id="@+id/iv_preview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:visibility="gone" /> <Button
        android:id="@+id/btn_upload_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="צרף קובץ (PDF/Doc)" />

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="לא נבחר קובץ"
            android:textColor="#757575"/>

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="שלח / שמור"
            android:backgroundTint="#4CAF50"/>
        <Button
            android:id="@+id/btn_pop_up_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="הוספה לקבוצה"
            android:backgroundTint="#4CAF50"/>

    </LinearLayout>
</ScrollView>